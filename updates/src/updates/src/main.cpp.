    }
    y += 90 * u;
    Rectangle go{ cx - 120 * u, y, 240 * u, 70 * u };
    if (Btn(go, T("START", "ابدأ"), Color{40,160,70,255}, (int)(36 * u)) || IsKeyPressed(KEY_ENTER)) StartGame();
    y += 90 * u;

    TxtC(T("One roll per turn. Close both dice tiles (e.g. 2 and 3) or just their sum (5).",
           "رمية وحدة بكل دور. اغلق قطعتي الزهرتين (مثلا 2 و 3) أو قطعة المجموع بس (5)."),
         cx, y, (int)(18 * u), Color{230,230,230,255});
    TxtC(T("Can't move? Your open tiles are your score. Lowest score wins!",
           "إذا ما تقدر تلعب، القطع المفتوحة هي نقاطك. الأقل نقاط يفوز!"),
         cx, y + 26 * u, (int)(18 * u), Color{230,230,230,255});

    if (Btn(SettingsBtnRect(), T("Settings", "الإعدادات"), Color{70,70,90,255}, (int)(20 * u)))
        g_settings = true;
}

// "press back again" message
void DrawBackToast() {
    if (GetTime() - g_backT >= 2.0) return;
    const float u = UIScale();
    const float W = (float)GetScreenWidth();
    const char* m = T("Press BACK again to return to the main menu", "اضغط رجوع مرة ثانية حتى ترجع للقائمة الرئيسية");
    const int fs = (int)(22 * u);
    const float w = TxtW(m, fs) + 40 * u;
    DrawRectangleRounded(Rectangle{W / 2 - w / 2, 100 * u, w, 44 * u}, 0.3f, 8, Fade(BLACK, 0.7f));
    TxtC(m, W / 2, 100 * u + (44 * u - fs) / 2, fs, Color{255,225,110,255});
}

void DrawHUD() {
    const float u = UIScale();
    const float W = (float)GetScreenWidth();
    const float H = (float)GetScreenHeight();
    const int seat = CurSeat();

    Txt("Q BOOL", 14 * u, 10 * u, (int)(30 * u), Color{255,210,70,255});

    // scoreboard (top-right)
    const float boxW = 236 * u;
    const float boxX = W - boxW - 12 * u;
    DrawRectangleRounded(Rectangle{boxX, 6 * u, boxW, (g.numPlayers * 28 + 12) * u}, 0.15f, 6, Fade(BLACK, 0.45f));
    for (int i = 0; i < g.numPlayers; ++i) {
        const int s = g.seats[i];
        const float rowY = (10 + i * 28) * u;
        char line[64];
        if (g.done[i]) std::snprintf(line, sizeof(line), g_ar ? "%s: نقاط %d" : "%s: score %d", SeatName(s), g.scores[i]);
        else           std::snprintf(line, sizeof(line), g_ar ? "%s: مفتوح %d" : "%s: open %d", SeatName(s), g.boards[s].openSum());
        const bool isCur = (i == g.cur && g.state != State::GameOver);
        const Color tc = isCur ? Color{255,230,120,255} : WHITE;
        if (g_ar) {
            const float sqX = boxX + boxW - 10 * u - 16 * u;
            DrawRectangle((int)sqX, (int)(rowY + 2 * u), (int)(16 * u), (int)(16 * u), SEAT_COL[s]);
            TxtR(line, sqX - 8 * u, rowY, (int)(18 * u), tc);
        } else {
            DrawRectangle((int)(boxX + 10 * u), (int)(rowY + 2 * u), (int)(16 * u), (int)(16 * u), SEAT_COL[s]);
            Txt(line, boxX + 34 * u, rowY, (int)(18 * u), tc);
        }
    }

    // turn banner
    char t[96];
    if (g_ar) std::snprintf(t, sizeof(t), "دور %s%s", SeatName(seat), IsBot(g.cur) ? " (كمبيوتر)" : "");
    else      std::snprintf(t, sizeof(t), "%s's turn%s", SeatName(seat), IsBot(g.cur) ? " (computer)" : "");
    TxtC(t, W / 2, 12 * u, (int)(34 * u), SEAT_COL[seat].r > 200 && SEAT_COL[seat].g > 180 ? SEAT_COL[seat] : ColorBrightness(SEAT_COL[seat], 0.35f));

    // roll info
    if (g.rollTotal > 0 && g.rollT >= 1.0f) {
        char r[96];
        if (g.oneDie) std::snprintf(r, sizeof(r), g_ar ? "الرمية: %d  (زهرة وحدة)" : "Roll: %d  (one die)", g.d1);
        else          std::snprintf(r, sizeof(r), g_ar ? "الرمية: %d + %d = %d" : "Roll: %d + %d = %d", g.d1, g.d2, g.rollTotal);
        TxtC(r, W / 2, 58 * u, (int)(28 * u), WHITE);
    }

    if (g.state == State::WaitRoll && !IsBot(g.cur) && fabsf(g.camDiff) < 0.12f) {
        Rectangle rr = RollRect();
        if (g_hints) {
            const float pulse = Pulse(6.0f);
            TxtC(T("Tap ROLL to throw the dice", "اضغط على الزر حتى ترمي الزهر"),
                 W / 2, H - 150 * u, (int)(22 * u), Color{150,220,255,255});
            rr = Grow(rr, 5 * u * pulse);
        }
        if (Btn(rr, T("ROLL", "ارمي"), Color{220,120,20,255}, (int)(34 * u))) DoRoll();
    }
    if (g.state == State::Choose && !IsBot(g.cur)) {
        const int n = (int)g.combos.size();
        if (g_hints) {
            TxtC(T("Choose one: tap a blinking number, or a button below",
                   "اختار واحد: اضغط على الرقم اللي يلمع، أو على الزر اللي تحت"),
                 W / 2, H - 150 * u, (int)(20 * u), Color{150,220,255,255});
        }
        const float pulse = Pulse(8.0f);
        int picked = -1;
        for (int i = 0; i < n; ++i) {
            char lab[48];
            int a1 = 0, a2 = 0;
            for (int t2 = 1; t2 <= NUM_TILES; ++t2) if (g.combos[i] & (1u << t2)) { if (!a1) a1 = t2; else a2 = t2; }
            if (a2) std::snprintf(lab, sizeof(lab), g_ar ? "اغلق %d + %d" : "Close %d + %d", a1, a2);
            else    std::snprintf(lab, sizeof(lab), g_ar ? "اغلق %d" : "Close %d", a1);
            Rectangle br = OptionRect(i, n);
            if (g_hints) br = Grow(br, 4 * u * pulse);
            if (Btn(br, lab, i == 0 ? Color{40,140,200,255} : Color{200,120,30,255}, (int)(26 * u)))
                picked = i;
        }
        if (picked >= 0) { g.selected = g.combos[picked]; ConfirmSelection(); }
    }
    if (g.state == State::Pause && g.msgKind) {
        char m[96];
        if (g.msgKind == 1)
            std::snprintf(m, sizeof(m), g_ar ? "ما كو حركة!  %s: %d نقطة" : "No move!  %s scores %d", SeatName(g.msgSeat), g.msgScore);
        else
            std::snprintf(m, sizeof(m), g_ar ? "أغلق الصندوق بالكامل!  %s: 0 نقطة" : "SHUT THE BOX!  %s scores 0", SeatName(g.msgSeat));
        const int fs = (int)(40 * u);
        const float w = TxtW(m, fs) + 60 * u;
        DrawRectangleRounded(Rectangle{W / 2 - w / 2, H / 2 - 40 * u, w, 80 * u}, 0.3f, 8, Fade(BLACK, 0.65f));
        TxtC(m, W / 2, H / 2 - fs / 2.0f, fs, Color{255,225,110,255});
    }
    DrawBackToast();
#if defined(__EMSCRIPTEN__)
    if (H > W) TxtC(T("Tip: rotate your phone sideways", "نصيحة: دور الجهاز بالعرض"), W / 2, H - 28 * u, (int)(16 * u), Fade(WHITE, 0.8f));
#endif
}

void DrawGameOver() {
    const float u = UIScale();
    const float W = (float)GetScreenWidth(), H = (float)GetScreenHeight();
    DrawRectangle(0, 0, (int)W, (int)H, Fade(BLACK, 0.55f));
    int best = 1000;
    for (int i = 0; i < g.numPlayers; ++i) best = std::min(best, g.scores[i]);
    float y = H * 0.12f;
    TxtC(T("GAME OVER", "انتهت اللعبة"), W / 2, y, (int)(60 * u), Color{255,210,70,255});
    y += 90 * u;
    for (int i = 0; i < g.numPlayers; ++i) {
        const int s = g.seats[i];
        const bool win = g.scores[i] == best;
        char line[96];
        std::snprintf(line, sizeof(line), g_ar ? "%s   %d%s" : "%s   %d%s", SeatName(s), g.scores[i],
                      win ? (g_ar ? "   الفائز!" : "   WINNER!") : "");
        Color c = win ? Color{255,230,110,255} : WHITE;
        if (g_ar) {
            const float rightEdge = W / 2 + 170 * u;
            DrawRectangle((int)(rightEdge - 22 * u), (int)(y + 4 * u), (int)(22 * u), (int)(22 * u), SEAT_COL[s]);
            TxtR(line, rightEdge - 36 * u, y, (int)(30 * u), c);
        } else {
            DrawRectangle((int)(W / 2 - 170 * u), (int)(y + 4 * u), (int)(22 * u), (int)(22 * u), SEAT_COL[s]);
            Txt(line, W / 2 - 135 * u, y, (int)(30 * u), c);
        }
        y += 46 * u;
    }
    y += 24 * u;
    if (Btn(Rectangle{W / 2 - 130 * u, y, 260 * u, 66 * u}, T("PLAY AGAIN", "العب مرة ثانية"), Color{40,160,70,255}, (int)(30 * u))
        || IsKeyPressed(KEY_ENTER)) ToMenu();
    DrawBackToast();
}

// Settings screen: language (Arabic / English) and hints (on / off).
void DrawSettings() {
    const float u = UIScale();
    const float W = (float)GetScreenWidth(), H = (float)GetScreenHeight();
    DrawRectangle(0, 0, (int)W, (int)H, Fade(BLACK, 0.72f));
    const float pw = 520 * u, ph = 400 * u;
    const float px = W / 2 - pw / 2, py = H / 2 - ph / 2;
    DrawRectangleRounded(Rectangle{px, py, pw, ph}, 0.08f, 8, Color{44,34,30,250});
    const Color on  = Color{230,150,20,255};
    const Color off = Color{70,70,90,255};
    const float cx = W / 2;
    float y = py + 16 * u;
    TxtC(T("Settings", "الإعدادات"), cx, y, (int)(42 * u), Color{255,210,70,255});

    y += 80 * u;
    TxtC(T("Language", "اللغة"), cx, y, (int)(26 * u), WHITE);
    y += 38 * u;
    if (Btn(Rectangle{cx - 190 * u, y, 180 * u, 54 * u}, "العربية", g_ar ? on : off, (int)(26 * u))) g_ar = true;
    if (Btn(Rectangle{cx + 10 * u,  y, 180 * u, 54 * u}, "English", !g_ar ? on : off, (int)(26 * u))) g_ar = false;

    y += 80 * u;
    TxtC(T("Hints", "التلميحات"), cx, y, (int)(26 * u), WHITE);
    y += 38 * u;
    if (Btn(Rectangle{cx - 190 * u, y, 180 * u, 54 * u}, T("On", "تشغيل"),  g_hints ? on : off, (int)(26 * u))) g_hints = true;
    if (Btn(Rectangle{cx + 10 * u,  y, 180 * u, 54 * u}, T("Off", "إيقاف"), !g_hints ? on : off, (int)(26 * u))) g_hints = false;

    y += 84 * u;
    if (Btn(Rectangle{cx - 110 * u, y, 220 * u, 56 * u}, T("Back", "رجوع"), Color{40,160,70,255}, (int)(28 * u))
        || IsKeyPressed(KEY_ENTER)) g_settings = false;
}

void Draw() {
    BeginDrawing();
    ClearBackground(Color{28,22,20,255});
    BeginMode3D(cam);
    DrawScene();
    EndMode3D();
    DrawTileNumbers();
    if (g_settings)                      DrawSettings();
    else if (g.state == State::Menu)     DrawMenu();
    else if (g.state == State::GameOver) DrawGameOver();
    else                                 DrawHUD();
    EndDrawing();
}

void Frame() {
    float dt = GetFrameTime();
    if (dt > 0.05f) dt = 0.05f;
    Update(dt);
    Draw();
}

} // namespace

int main() {
    int w = 1280, h = 720;
#if defined(__EMSCRIPTEN__)
    w = EM_ASM_INT({ return window.innerWidth; });
    h = EM_ASM_INT({ return window.innerHeight; });
#endif
#if defined(__ANDROID__)
    w = 0; h = 0;   // 0,0 = use the whole phone/tablet screen
#endif
    SetConfigFlags(FLAG_MSAA_4X_HINT | FLAG_WINDOW_RESIZABLE | FLAG_VSYNC_HINT);
    InitWindow(w, h, "Q BOOL");
    SetTargetFPS(60);
    SetRandomSeed((unsigned int)std::time(nullptr));
    LoadUIFonts();
    InitGraphics();

    g.numPlayers = 4;
    for (int s = 0; s < 4; ++s)
        for (int n = 0; n <= NUM_TILES; ++n) g.angle[s][n] = g.boards[s].open[n] ? OPEN_ANG : 0.0f;
    cam.up = Vector3{0, 1, 0};

#if defined(__EMSCRIPTEN__)
    emscripten_set_main_loop(Frame, 0, 1);
#else
    while (!WindowShouldClose()) Frame();
#endif
    CloseWindow();
    return 0;
}
